    "keywords": [
        "backend",
        "duckphp"
    ],
    "homepage": "https://www.github.com/dvaknheo/duckadmin",
    "license": "MIT",
    "authors": [
        {
            "name": "davknheo",
            "email": "davknheo@qq.com"
        }
